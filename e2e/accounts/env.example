# End-to-end suite for accounts v2: run with `npm run e2e:accounts` (or `npm run e2e:accounts -- --env e2e/accounts/.env`).
# The suite imports src/accounts, so it tests the SDK source, not the built dist/accounts (npm run build and check:dist
# cover the build output).
# Run it only against dev, once did-directory, dauth /signin and accounts v2 are deployed there.
# Every scenario creates its own accounts (e2e+<scenario>-<timestamp>-<rand>@E2E_EMAIL_DOMAIN)
# and deletes them at the end; it never touches any other account.

# Service hosts. ACCOUNTS_URL is the dev host, never a Vercel preview URL (the token audience would not match).
ACCOUNTS_URL=https://accounts.dev.dimo.org
DAUTH_URL=https://dauth.dev.dimo.zone
DIRECTORY_URL=https://did.dev.dimo.zone

# Polygon Amoy (chain id 80002), the chain accounts' "POLYGON" resolves to outside production.
RPC_URL_80002=

# accounts' CRON_SECRET (E17 calls GET /api/v2/internal/sweep-signups?maxAgeHours=0; dev only).
# That sweep is global: it also closes any other abandoned signup on dev at that moment.
CRON_SECRET=

# Dev Turnkey parent org, with an API key used READ-ONLY (getOrganization, getSubOrgIds,
# getWalletAccounts) to check each sub-org's root quorum and read its wallet's public key.
TURNKEY_PARENT_ORG_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# optional, default https://api.turnkey.com
# TURNKEY_BASE_URL=
# optional: how the k1 wallet signer asks Turnkey to sign (sha256-text | noop-digest), default sha256-text.
# Use whichever Task 1's spike printed as VERIFIED.
# E2E_TURNKEY_SIGN_MODE=sha256-text

# Domain whose mailbox MAILBOX_API serves. Emails are e2e+<scenario>-<timestamp>-<rand>@<domain>.
E2E_EMAIL_DOMAIN=

# The partner identity used by E11's partner lookup. Its DID must be in accounts' PARTNER_LOOKUP_DIDS
# and have an ECDSA P-256 verification method under `fragment`. One line of JSON:
# {"did":"did:dimo:...","fragment":"signing","privateKeyJwk":{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}}
E2E_PARTNER_DID_KEY=

# Mailbox service contract (the suite does not read real inboxes). MAILBOX_API is its base URL, no trailing slash.
#   GET ${MAILBOX_API}/latest?to=<email>
#     200 {"code":"123456"}  the most recent sign-in code accounts emailed to <email>
#     404                    nothing received for <email> yet
#   <email> is the full address, percent-encoded. "Latest" means by arrival time. The suite remembers the
#   code that was latest before it asks for a new one and waits for a different one, so the service must
#   not drop or reorder codes.
MAILBOX_API=

# Opt-ins for the two scenarios that affect more than their own accounts (otherwise they print SKIP):
#  * E2E_ALLOW_GLOBAL_SWEEP=1 lets E17 call sweep-signups?maxAgeHours=0. That strips DIMO from EVERY pending
#    sub-org on dev, including other developers' in-flight signups. Only set it on a dev nobody else is using.
#  * E2E_ALLOW_BULK=1 lets E18 create 300 accounts (300 Turnkey sub-orgs, then mailbox traffic and a slow cleanup).
# E2E_ALLOW_GLOBAL_SWEEP=
# E2E_ALLOW_BULK=

# WebAuthn relying party for E8's software passkey (the rpId hash and the registration clientData origin).
# Required, no defaults. Take them from the real dev setup: E2E_WEBAUTHN_RP_ID is the dev accounts
# deployment's WEBAUTHN_RP_ID environment variable; E2E_WEBAUTHN_ORIGIN is the origin of the dev login app
# (scheme and host only, no path).
E2E_WEBAUTHN_RP_ID=
E2E_WEBAUTHN_ORIGIN=

# Hosts must be https and end in .dev.dimo.org or .dev.dimo.zone (the suite exits 2 otherwise).
# Extra exact hostnames (a local or staging dev stack) go in a comma list; nothing else widens the check:
# E2E_EXTRA_DEV_HOSTS=

# Preconditions on dev (set on the accounts deployment, not here):
#  * V2_PUBLIC_RATE_LIMIT_PER_MINUTE unset, or >= 300. E18 makes 300 signups in 60 s from one client.
#    If the very first E18 request is already a 429, E18 prints SKIP with that reason; any later 429 is a FAIL.
#  * ACCOUNT_CREATE_REQUIRE_PROOF off (E8 and E9 create v1 accounts without a token).
#  * PARTNER_LOOKUP_DIDS contains the partner DID above.
#  * V2_EMAIL_CODE_MIN_INTERVAL_SECONDS / V2_EMAIL_CODE_MAX_PER_HOUR at their defaults (30 s, 10) or looser:
#    the suite waits 31 s between codes for the same email.

# Load on shared dev:
#  * E18 (opt-in, E2E_ALLOW_BULK=1) creates about 300 Turnkey sub-orgs and sends about 300 OTP emails
#    (about 600 with the cleanup logins), all against the shared dev Turnkey org and mailbox.
#  * E9 leaves orphan DIDs in did-directory: claimDid creates a new one on every run and the suite
#    does not tombstone it. Expect them to accumulate on dev.

# Cleanup of E18's 300 accounts logs each in by email code and deletes it. Set 0 to leave them.
# E2E_BULK_CLEANUP=1
# E2E_CLEANUP_CONCURRENCY=5
# gas provider E10's UserOp-sender check goes through: alchemy | gelato | pimlico
# E2E_GAS_PROVIDER=alchemy
