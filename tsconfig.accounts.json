{
  // Type-checks the accounts modules with the compiler options they were
  // written against (ES2022, bundler resolution, noUncheckedIndexedAccess). tsup builds
  // src/accounts with it too. The rest of the repo uses tsconfig.json / tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // As tsconfig.base.json.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/accounts", "tsup.config.ts"]
}
